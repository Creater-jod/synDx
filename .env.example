# ==============================================================================
# synDx Production Environment Configuration Template
# Offline-First Clinical Decision Support & Doctor Review Console
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Security: JSON Web Token Secret
# MANDATORY IN PRODUCTION: Must be set to a cryptographically random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=syndx-dev-secret-do-not-use-in-production-min32chars!!

# CORS Configuration: Comma-separated list of allowed origins
# Restrict to trusted clinic review workstation origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# SQLite Database Storage Location
DB_PATH=data/syndx_production.db

# External Python FastAPI ML Microservice URL (Kept Separate on Port 8000)
ML_SERVICE_URL=http://127.0.0.1:8000

# Default Seed Administrator Credentials (Only used on initial database initialization)
DEFAULT_ADMIN_PASSWORD=password123
